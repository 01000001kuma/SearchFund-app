# ===== Search Fund Tool — Configuración (copiar a .env) =====
# Copia este archivo a `backend/.env` o a `.env` en la raíz y ajusta.

# --- Proveedor LLM (HÍBRIDO) ---
# "ollama" (local, gratis, por defecto) | "openai" | "anthropic"
LLM_PROVIDER=ollama

# Ollama local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Modelo rápido para extracciones estructuradas (contactos, fit score).
# Más pequeño y veloz en CPU. Vacío = reutiliza OLLAMA_MODEL.
OLLAMA_FAST_MODEL=llama3.2:3b

# API de pago (OpenAI-compatible) — solo si LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# API de pago (Anthropic) — solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Parámetros de generación
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=300

# --- Búsqueda de candidatas (criterios Cabiedes) ---
SEARCH_MAX_RESULTS=8
# Provincias a priorizar (vacío = todas)
SEARCH_PROVINCES=
# Sectores/CNAE a explorar (nombres registrales para OpenMercantil)
SEARCH_SECTORS=transportes,construcciones,alimentacion,industrial

# --- Base de datos ---
DB_PATH=data/search_fund.db
